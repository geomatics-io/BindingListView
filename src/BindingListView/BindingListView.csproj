<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net48;netstandard2.0</TargetFrameworks>
    <RootNamespace>Equin.ApplicationFramework</RootNamespace>
    <AssemblyName>BindingListView</AssemblyName>
  </PropertyGroup>

  <!-- Assembly / NuGet package metadata. Version-related properties (Version,
       AssemblyVersion, FileVersion, InformationalVersion, PackageVersion) are
       NOT set here - MinVer (see below) computes and sets them from the git
       history at build time. -->
  <PropertyGroup>
    <Product>BindingListView</Product>
    <Company>Equin</Company>
    <PackageId>Geomatics.IO.BindingListView</PackageId>
    <Authors>Andrew Davey, Christian Arielli</Authors>
    <Copyright>Copyright 2017-2026</Copyright>
    <Description>Sort, filter and aggregate lists of business objects without all the boring code! This library provides a powerful "view" approach to data binding .NET objects to user interface controls.</Description>
    <PackageProjectUrl>https://github.com/geomatics-io/BindingListView</PackageProjectUrl>
    <RepositoryUrl>https://github.com/geomatics-io/BindingListView</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>csharp;csharp-library;dotnet;winforms;datagridview;sort;filter</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <!-- SPDX identifier for the BSD 3-Clause License in ..\..\LICENSE (original
         SourceForge project license; SourceForge's own project page states only
         "BSD License" without a variant, so BSD 3-Clause was chosen as the most
         common default for that wording). -->
    <PackageLicenseExpression>BSD-3-Clause</PackageLicenseExpression>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Update="Properties\Resources.resx">
      <Generator>ResXFileCodeGenerator</Generator>
      <LastGenOutput>Resources.Designer.cs</LastGenOutput>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
    <None Include="..\..\LICENSE" Pack="true" PackagePath="\" />
  </ItemGroup>

  <!-- Computes Version/AssemblyVersion/FileVersion/InformationalVersion/PackageVersion
       from the nearest reachable "vX.Y.Z" git tag (plus commit height for untagged
       commits, e.g. 1.3.3-alpha.0.4 four commits after v1.3.2). Non-SemVer tags such
       as v1.2.2.0 are ignored, not an error.
       Requires the CI checkout to fetch full history (fetch-depth: 0), otherwise no
       tags are visible and MinVer falls back to 0.0.0-alpha.0. -->
  <PropertyGroup>
    <MinVerTagPrefix>v</MinVerTagPrefix>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MinVer" Version="7.0.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <!-- .NET Standard 2.0's netstandard.dll reference assembly does not declare
       System.Reflection.Emit (DynamicMethod/ILGenerator), used for the fast
       property-access delegates built when sorting. .NET Framework already has
       these in mscorlib, so they are only needed for netstandard2.0. -->
  <ItemGroup Condition="'$(TargetFramework)'=='netstandard2.0'">
    <PackageReference Include="System.Reflection.Emit" Version="4.3.0" />
    <PackageReference Include="System.Reflection.Emit.ILGeneration" Version="4.3.0" />
    <PackageReference Include="System.Reflection.Emit.Lightweight" Version="4.3.0" />
  </ItemGroup>

</Project>
